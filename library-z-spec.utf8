\documentclass{article}
\usepackage{oz}

\begin{document}


─ section LibrarySystem parents standard_toolkit └ 


─ [ PERSON , ISBN , TITLE ] └ 

─ GENRE ::= fiction | nonfiction | science | history | biography └ 

─ REPORT ::= ok | bookNotFound | memberNotFound | bookAlreadyExists | memberAlreadyExists | alreadyBorrowed | notBorrowed | loanLimitReached └ 

╷ maxLoans : ℕ↘1↖ |
 maxLoans = 5 └ 


┌ Library 
books : ℙ ISBN 
members : ℙ PERSON 
title : ISBN ⇸ TITLE 
genre : ISBN ⇸ GENRE 
loans : ISBN ⇸ PERSON 
waitlist : ISBN ⇸ seq PERSON |
 dom title = books 
dom genre = books 
dom loans ⊆ books 
ran loans ⊆ members 
dom waitlist ⊆ books 
∀ m : members ⦁ # { b : dom loans | loans ( b ) = m } ≤ maxLoans └ 


╷ borrowedBy : PERSON × ℙ ( ISBN × PERSON ) → ℙ ISBN |
 ∀ m : PERSON ; ln : ℙ ( ISBN × PERSON ) ⦁ borrowedBy ( m , ln ) = { b : dom ln | ( b , m ) ∈ ln } └ 

╷ availableBooks : ℙ ISBN × ℙ ( ISBN × PERSON ) → ℙ ISBN |
 ∀ bs : ℙ ISBN ; ln : ℙ ( ISBN × PERSON ) ⦁ availableBooks ( bs , ln ) = bs ∖ dom ln └ 

╷ loanCount : PERSON × ℙ ( ISBN × PERSON ) → ℕ |
 ∀ m : PERSON ; ln : ℙ ( ISBN × PERSON ) ⦁ loanCount ( m , ln ) = # { b : dom ln | ( b , m ) ∈ ln } └ 

╷ booksByGenre : GENRE × ℙ ISBN × ( ISBN ⇸ GENRE ) → ℙ ISBN |
 ∀ g : GENRE ; bs : ℙ ISBN ; gn : ISBN ⇸ GENRE ⦁ booksByGenre ( g , bs , gn ) = { b : bs | b ∈ dom gn ∧ gn ( b ) = g } └ 


┌ InitLibrary 
Library ′ |
 books′ = ∅ 
members′ = ∅ 
title′ = ∅ 
genre′ = ∅ 
loans′ = ∅ 
waitlist′ = ∅ └ 


┌ AddBook 
ΔLibrary 
isbn? : ISBN 
t? : TITLE 
g? : GENRE |
 isbn? ∉ books 
books′ = books ∪ { isbn? } 
title′ = title ∪ { isbn? ↦ t? } 
genre′ = genre ∪ { isbn? ↦ g? } 
waitlist′ = waitlist ∪ { isbn? ↦ ⟨ ⟩ } 
loans′ = loans 
members′ = members └ 

┌ RemoveBook 
ΔLibrary 
isbn? : ISBN |
 isbn? ∈ books 
isbn? ∉ dom loans 
books′ = books ∖ { isbn? } 
title′ = { isbn? } ⩤ title 
genre′ = { isbn? } ⩤ genre 
waitlist′ = { isbn? } ⩤ waitlist 
loans′ = loans 
members′ = members └ 

┌ RegisterMember 
ΔLibrary 
p? : PERSON |
 p? ∉ members 
members′ = members ∪ { p? } 
books′ = books 
title′ = title 
genre′ = genre 
loans′ = loans 
waitlist′ = waitlist └ 

┌ RemoveMember 
ΔLibrary 
p? : PERSON |
 p? ∈ members 
p? ∉ ran loans 
members′ = members ∖ { p? } 
books′ = books 
title′ = title 
genre′ = genre 
loans′ = loans 
waitlist′ = waitlist └ 

┌ BorrowBook 
ΔLibrary 
isbn? : ISBN 
p? : PERSON |
 isbn? ∈ books 
p? ∈ members 
isbn? ∉ dom loans 
loanCount ( p? , loans ) < maxLoans 
loans′ = loans ∪ { isbn? ↦ p? } 
books′ = books 
members′ = members 
title′ = title 
genre′ = genre 
waitlist′ = waitlist └ 

┌ ReturnBook 
ΔLibrary 
isbn? : ISBN 
p? : PERSON |
 isbn? ∈ dom loans 
loans ( isbn? ) = p? 
loans′ = { isbn? } ⩤ loans 
books′ = books 
members′ = members 
title′ = title 
genre′ = genre 
waitlist′ = waitlist └ 

┌ SearchByGenre 
ΞLibrary 
g? : GENRE 
result! : ℙ ISBN |
 books ≠ ∅ 
result! = booksByGenre ( g? , books , genre ) └ 

┌ GetMemberBooks 
ΞLibrary 
p? : PERSON 
result! : ℙ ISBN |
 p? ∈ members 
result! = borrowedBy ( p? , loans ) └ 


┌ Success 
r! : REPORT |
 r! = ok └ 

┌ BookNotFoundError 
ΞLibrary 
r! : REPORT |
 r! = bookNotFound └ 

┌ MemberNotFoundError 
ΞLibrary 
r! : REPORT |
 r! = memberNotFound └ 

┌ BookAlreadyExistsError 
ΞLibrary 
r! : REPORT 
isbn? : ISBN |
 isbn? ∈ books 
r! = bookAlreadyExists └ 

┌ MemberAlreadyExistsError 
ΞLibrary 
r! : REPORT 
p? : PERSON |
 p? ∈ members 
r! = memberAlreadyExists └ 

┌ AlreadyBorrowedError 
ΞLibrary 
r! : REPORT 
isbn? : ISBN |
 isbn? ∈ dom loans 
r! = alreadyBorrowed └ 

┌ NotBorrowedError 
ΞLibrary 
r! : REPORT 
isbn? : ISBN |
 isbn? ∉ dom loans 
r! = notBorrowed └ 

┌ LoanLimitError 
ΞLibrary 
r! : REPORT 
p? : PERSON |
 loanCount ( p? , loans ) ≥ maxLoans 
r! = loanLimitReached └ 

─ AddBookOk == AddBook ∧ Success └ 

─ TotalAddBook == AddBookOk ∨ BookAlreadyExistsError └ 

┌ BookOnLoan 
Library 
isbn? : ISBN |
 isbn? ∈ dom loans └ 

─ BookNotOnLoan == ¬ BookOnLoan └ 

─ BorrowAndQuery == BorrowBook ⨟ GetMemberBooks └ 

─ BorrowBookOk == BorrowBook ∧ Success └ 

─ TotalBorrowBook == BorrowBookOk ∨ BookNotFoundError ∨ AlreadyBorrowedError ∨ LoanLimitError └ 

─ ReturnBookOk == ReturnBook ∧ Success └ 

─ TotalReturnBook == ReturnBookOk ∨ NotBorrowedError └ 


┌ ConcreteLibrary 
cbooks : seq ISBN 
cmembers : seq PERSON 
ctitle : seq ( ISBN × TITLE ) 
cgenre : seq ( ISBN × GENRE ) 
cloans : seq ( ISBN × PERSON ) 
cwaitlist : seq ( ISBN × seq PERSON ) |
 ∀ i , j : dom cbooks ⦁ i ≠ j ⇒ cbooks ( i ) ≠ cbooks ( j ) 
∀ i , j : dom cmembers ⦁ i ≠ j ⇒ cmembers ( i ) ≠ cmembers ( j ) 
∀ i : dom cloans ⦁ first ( cloans ( i ) ) ∈ ran cbooks 
∀ i : dom cloans ⦁ second ( cloans ( i ) ) ∈ ran cmembers 
∀ m : ran cmembers ⦁ # { i : dom cloans | second ( cloans ( i ) ) = m } ≤ maxLoans └ 

┌ Retrieve 
Library 
ConcreteLibrary |
 books = ran cbooks 
members = ran cmembers 
title = ran ctitle 
genre = ran cgenre 
loans = ran cloans 
waitlist = ran cwaitlist └ 

┌ ConcreteInitLibrary 
ConcreteLibrary ′ |
 cbooks′ = ⟨ ⟩ 
cmembers′ = ⟨ ⟩ 
ctitle′ = ⟨ ⟩ 
cgenre′ = ⟨ ⟩ 
cloans′ = ⟨ ⟩ 
cwaitlist′ = ⟨ ⟩ └ 

┌ ConcreteBorrowBook 
ΔConcreteLibrary 
isbn? : ISBN 
p? : PERSON |
 isbn? ∈ ran cbooks 
p? ∈ ran cmembers 
¬ ( ∃ i : dom cloans ⦁ first ( cloans ( i ) ) = isbn? ) 
# { i : dom cloans | second ( cloans ( i ) ) = p? } < maxLoans 
cloans′ = cloans ⁀ ⟨ ( isbn? , p? ) ⟩ 
cbooks′ = cbooks 
cmembers′ = cmembers 
ctitle′ = ctitle 
cgenre′ = cgenre 
cwaitlist′ = cwaitlist └ 

┌ ConcreteReturnBook 
ΔConcreteLibrary 
isbn? : ISBN 
p? : PERSON |
 ∃ i : dom cloans ⦁ cloans ( i ) = ( isbn? , p? ) 
ran cloans′ = ran cloans ∖ { ( isbn? , p? ) } 
∀ i : dom cloans′ ⦁ cloans′ ( i ) ∈ ran cloans ∖ { ( isbn? , p? ) } 
cbooks′ = cbooks 
cmembers′ = cmembers 
ctitle′ = ctitle 
cgenre′ = cgenre 
cwaitlist′ = cwaitlist └ 

┌ ConcreteSearchByGenre 
ΞConcreteLibrary 
g? : GENRE 
result! : ℙ ISBN |
 ran cbooks ≠ ∅ 
result! = { i : dom cgenre | second ( cgenre ( i ) ) = g? ⦁ first ( cgenre ( i ) ) } └ 

